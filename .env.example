# ======================================================================
# 必填：LLM API 設定（OpenAI-Compatible Endpoint）
# ======================================================================
# 範例：OpenAI 官方 API（亦可用其他相容 /v1 的服務）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_BASE=https://api.openai.com/v1

# CrewAI 預設模型（可在 config/agents.yaml 中覆寫）
OPENAI_MODEL_NAME=gpt-4.1-mini

# ======================================================================
# 選用：OpenEvolve 執行參數（可在 CLI 動態指定）
# ======================================================================
# 每次 evaluate() 要跑幾個 task（預設 5）
# OPENEVOLVE_NUM_TASKS=5

# 每次 evaluate() 內部 simulation 的 hard timeout（秒，預設 900 = 15 分鐘）
# 超過會回傳 fallback fitness 讓 OpenEvolve 能繼續下一個 iteration
# OPENEVOLVE_SIM_TIMEOUT=900

# 設為 1 時略過「頂層 key / 子 key 與底稿一致」結構檢查（除錯用，預設勿開）
# OPENEVOLVE_SKIP_STRUCTURE_GUARD=1

# 由 OpenEvolve 自動寫入，指向當前迭代的 tasks 或 agents YAML 暫存路徑
# OPENEVOLVE_TASKS_YAML=   ← 演化 tasks 時由 evaluator 設定，不要手動設
# OPENEVOLVE_AGENTS_YAML=  ← 若手動跑自訂 agents 覆寫時再用；evolve tasks 時 evaluator 會清除
